{
  "name": "@forge/desktop",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "build:electron": "tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json",
    "build": "pnpm build:electron",
    "typecheck": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.preload.json",
    "test": "node --test tests/*.test.mjs",
    "dev:electron": "pnpm --filter @forge/host build && pnpm build:electron && electron .",
    "start": "electron ."
  },
  "dependencies": {
    "@forge/contracts": "workspace:*",
    "@forge/host": "workspace:*",
    "@forge/web": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.9.0",
    "electron": "44.4.3"
  }
}
