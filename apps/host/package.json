{
  "name": "@forge/host",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "dev": "pnpm build && node dist/index.js",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@forge/contracts": "workspace:*",
    "@forge/core": "workspace:*",
    "@forge/persistence": "workspace:*",
    "@forge/process": "workspace:*",
    "@forge/workspace": "workspace:*",
    "@forge/plugin-api": "workspace:*",
    "@forge/executor-codex": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.20.4"
  }
}
